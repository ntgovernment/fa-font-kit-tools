{
  "name": "fa-font-kit-tools",
  "version": "1.0.0",
  "description": "Font Awesome kit loader and GraphQL client",
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "fa-usage": "npm run build && node dist/lib/faUsageDetector/faUsageDetector.cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhysburnie/ntgFontKit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rhysburnie/ntgFontKit/issues"
  },
  "homepage": "https://github.com/rhysburnie/ntgFontKit#readme",
  "dependencies": {
    "@awesome.me/kit-00b1b3bcf8": "^1.0.5",
    "@awesome.me/kit-41b791824a": "^1.0.17",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
